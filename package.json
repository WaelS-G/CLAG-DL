{
  "name": "clag-downloader",
  "version": "1.0.0",
  "description": "Next-Generation Multi-Connection Download Manager & Universal Media Grabber",
  "main": "dist/server/server/server.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:client": "vite build",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "build:all": "npm run build:client && npm run build:server",
    "start": "node dist/server/server/server.js",
    "server:dev": "tsx watch src/server/server.ts",
    "python:cli": "python -m src.python.clag_cli",
    "python:gui": "python -m src.python.clag_desktop",
    "build:exe": "python scripts/build_exe.py",
    "package:ext": "node scripts/package_extension.js",
    "test": "node --test"
  },
  "keywords": [
    "downloader",
    "idm",
    "jdownloader",
    "media-grabber",
    "video-downloader",
    "chunked-download",
    "multithreaded",
    "youtube",
    "hls",
    "ffmpeg",
    "pwa"
  ],
  "author": "Wael Sayed",
  "license": "MIT",
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
